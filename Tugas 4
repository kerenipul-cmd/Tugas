# Class Induk 1
class Pegawai:
    def __init__(self, id_pegawai, nama, gaji):
        self.id_pegawai = id_pegawai
        self.nama = nama
        self.gaji = gaji

    def info_pegawai(self):
        return f"ID: {self.id_pegawai} | Nama: {self.nama} | Gaji: Rp {self.gaji:,}"

# Class Induk 2
class PegawaiProyek:
    def __init__(self, nama_proyek):
        self.nama_proyek = nama_proyek

    def info_proyek(self):
        return f"Proyek Aktif: {self.nama_proyek}"

# Class Turunan Multiple Inheritance
class ProjectManager(Pegawai, PegawaiProyek):
    def __init__(self, id_pegawai, nama, gaji, nama_proyek, tunjangan_manajerial):
        # Inisialisasi dari kedua Class Induk
        Pegawai.__init__(self, id_pegawai, nama, gaji)
        PegawaiProyek.__init__(self, nama_proyek)
        self.tunjangan_manajerial = tunjangan_manajerial

    def total_pendapatan(self):
        return self.gaji + self.tunjangan_manajerial

    def tampilkan_laporan(self):
        print(f"=== LAPORAN PROJECT MANAGER ===")
        print(self.info_pegawai())
        print(self.info_proyek())
        print(f"Tunjangan : Rp {self.tunjangan_manajerial:,}")
        print(f"Total THP : Rp {self.total_pendapatan():,}")
        print("-" * 35)

# Instansiasi Objek
pm1 = ProjectManager("PM-001", "Budi Santoso", 12000000, "Sistem E-Commerce", 3500000)

# Output Laporan PM
print("=== KASUS 03: MANAJEMEN PEGAWAI ===")
pm1.tampilkan_laporan()
