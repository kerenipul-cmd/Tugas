# Class Induk
class Kendaraan:
    def __init__(self, nama, merk, tahun, kecepatan):
        self.nama = nama
        self.merk = merk
        self.tahun = tahun
        self.kecepatan = kecepatan

    def info_kendaraan(self):
        return f"{self.merk} {self.nama} ({self.tahun}) - Kecepatan Maks: {self.kecepatan} km/jam"

# Class Turunan 1: Mobil
class Mobil(Kendaraan):
    def __init__(self, nama, merk, tahun, kecepatan, jumlah_kursi):
        super().__init__(nama, merk, tahun, kecepatan)
        self.jumlah_kursi = jumlah_kursi

    def info_detail(self):
        return f"[MOBIL] {self.info_kendaraan()} | Kapasitas: {self.jumlah_kursi} Kursi"

# Class Turunan 2: Motor
class Motor(Kendaraan):
    def __init__(self, nama, merk, tahun, kecepatan, tipe_motor):
        super().__init__(nama, merk, tahun, kecepatan)
        self.tipe_motor = tipe_motor

    def info_detail(self):
        return f"[MOTOR] {self.info_kendaraan()} | Tipe: {self.tipe_motor}"

# Instansiasi Objek
mobil1 = Mobil("Avanza", "Toyota", 2022, 180, 7)
motor1 = Motor("NMAX", "Yamaha", 2023, 120, "Matik")

# Output Detail Kendaraan
print("=== KASUS 02: SISTEM RENTAL KENDARAAN ===")
print(mobil1.info_detail())
print(motor1.info_detail())
print("-" * 35)

