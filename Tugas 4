Studi kasus: 01

class Mahasiswa:
    def __init__(self, nama, nim, jurusan, nilai):
        self.nama = nama
        self.nim = nim
        self.jurusan = jurusan
        self.nilai = nilai

    def cek_status(self):
        if self.nilai >= 75:
            return "LULUS"
        else:
            return "TIDAK LULUS"

    def tampilkan_profil(self):
        print(f"NIM          : {self.nim}")
        print(f"Nama         : {self.nama}")
        print(f"Jurusan      : {self.jurusan}")
        print(f"Nilai        : {self.nilai}")
        print(f"Status       : {self.cek_status()}")
        print("-" * 35)

# Instansiasi Objek (Min. 2 Objek Mahasiswa)
mhs1 = Mahasiswa("Andi Pratama", "230101001", "Teknik Informatika", 82)
mhs2 = Mahasiswa("Siti Rahma", "230101002", "Sistem Informasi", 68)

# Output Profil
print("=== KASUS 01: DATA MAHASISWA ===")
mhs1.tampilkan_profil()
mhs2.tampilkan_profil()

